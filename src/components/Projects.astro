---
import ButtonLink from './shared/ButtonLink.astro'
import GitHub from '../assets/icons/GitHub.astro'
import WebIcon from '../assets/icons/WebIcon.astro'

import { PROJECTS } from '../data/projects'

const { id } = Astro.props

const projects = PROJECTS.filter((project) => project.home)
---

<section
  id={id}
  class="relative scroll-mt-16 overflow-x-hidden bg-background text-accent"
>
  <div class="max-w-6xl mx-auto px-4 lg:px-6 py-24">
    <!-- Encabezado -->
    <header class="mb-12">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none">
        Proyectos
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#6B665F] max-w-xl leading-relaxed">
        Algunos de los proyectos que he desarrollado.
      </p>
    </header>

    <!-- Proyectos -->
    <div class="flex flex-col gap-10 lg:gap-14">
      {
        projects.map((project, i) => (
          <article class="bg-[#F6EFE4] border border-accent/10 rounded-3xl p-4 sm:p-6 grid gap-8 lg:grid-cols-12 lg:gap-10 items-center">
            <div class="lg:col-span-6">
              <img
                class="block w-full aspect-16/10 object-cover rounded-2xl"
                src={project.image}
                alt={project.title}
                loading="lazy"
              />
            </div>

            <div class="lg:col-span-6 lg:pr-4 pb-2">
              <p class="text-sm font-semibold text-[#6B665F]">
                {String(i + 1).padStart(2, '0')} · {project.experience}
              </p>

              <h3 class="mt-2 text-2xl sm:text-3xl font-bold leading-tight text-[#0E7A65]">
                {project.title}
              </h3>

              <p class="mt-3 leading-relaxed text-accent/90">{project.description}</p>

              <ul
                class="mt-6 pt-5 border-t border-accent/10 flex flex-wrap gap-x-5 gap-y-3"
                aria-label="Tecnologías utilizadas"
              >
                {project.technologies.map((tech) => (
                  <li class="flex items-center gap-2 text-sm font-medium">
                    <img src={tech.image} class="w-4 h-4 object-contain" alt="" />
                    {tech.name}
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.live && (
                  <ButtonLink
                    href={project.live}
                    title={`Ver demo de proyecto ${project.title}`}
                    class="rounded-full bg-primary text-[#12161C] font-semibold uppercase tracking-wide hover:bg-primary/90"
                  >
                    <WebIcon size={20} />
                    Demo
                  </ButtonLink>
                )}
                {project.link && (
                  <ButtonLink
                    title={`Ver repositorio de proyecto ${project.title}`}
                    href={project.link}
                    class="rounded-full border border-accent/20 bg-transparent text-accent font-semibold uppercase tracking-wide hover:border-primary hover:bg-white/60"
                  >
                    <GitHub size={20} />
                    {project.linkText || 'Ver código'}
                  </ButtonLink>
                )}
                {project.linkBackend && (
                  <ButtonLink
                    title={`Ver repositorio backend de proyecto ${project.title}`}
                    href={project.linkBackend}
                    class="rounded-full border border-accent/20 bg-transparent text-accent font-semibold uppercase tracking-wide hover:border-primary hover:bg-white/60"
                  >
                    <GitHub size={20} />
                    {project.linkBackendText || 'Ver backend'}
                  </ButtonLink>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>