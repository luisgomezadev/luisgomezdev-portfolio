---
import { SKILLS } from '../data/skills'

const { id } = Astro.props

const groups = SKILLS.reduce<Record<string, typeof SKILLS>>((acc, skill) => {
  ;(acc[skill.category] ??= []).push(skill)
  return acc
}, {})
---

<section
  id={id}
  class="relative scroll-mt-16 overflow-x-hidden bg-[#F5EFE6] text-[#2B2A28]"
>
  <div class="max-w-6xl mx-auto px-4 lg:px-6 py-24">
    <!-- Encabezado -->
    <header class="grid gap-6 md:grid-cols-12 md:items-end mb-14">
      <h2
        class="md:col-span-7 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none"
      >
        Habilidades
      </h2>
      <p class="md:col-span-5 text-base sm:text-lg text-[#6B665F] max-w-md leading-relaxed">
        Tecnologías y prácticas que utilizo para llevar productos desde el análisis hasta
        producción.
      </p>
    </header>

    <!-- Categorías -->
    <div>
      {
        Object.entries(groups).map(([category, skills]) => (
          <div class="grid gap-6 md:grid-cols-12 border-t border-[#2B2A28]/10 py-8">
            <h3 class="md:col-span-3 md:sticky md:top-24 self-start text-lg sm:text-xl font-bold text-[#0E7A65] leading-snug md:max-w-56">
              {category}
            </h3>

            <ul class="md:col-span-9 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-5">
              {skills.map((skill) => (
                <li class="flex items-center gap-3">
                  <img
                    class="w-8 h-8 shrink-0 object-contain"
                    src={skill.icon}
                    alt=""
                    loading="lazy"
                  />
                  <span class="text-base font-medium">{skill.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>