---
const { id } = Astro.props

// `current: true` muestra la etiqueta "Actual" en la tarjeta
const experiences: {
  position: string
  company: string
  period: string
  description: string
  current?: boolean
}[] = [
  {
    position: 'Software Engineer',
    company: 'EPAM Neoris (Cliente: BBVA Colombia S.A.)',
    period: 'Oct 2026 — Actualidad',
    description:
      '',
    current: true,
  },
  {
    position: 'Software Developer',
    company: 'Digital ProfIT (Cliente: Bancamía S.A.)',
    period: 'Oct 2025 — Jul 2026',
    description:
      'Diseñé documentación técnica para servicios Java/Spring Boot utilizando UML y BPMN, y desarrollé pruebas automatizadas para aplicaciones web y móviles con Python, Appium y PyAutoGUI, mejorando la comprensión del sistema y la eficiencia del proceso de QA.',
  },
  {
    position: 'Freelance',
    company: 'Independiente',
    period: 'Nov 2024 — Oct 2025',
    description:
      'Desarrollé aplicaciones web a medida para diferentes clientes, participando en todo el proceso: desde el diseño de interfaces modernas hasta la implementación de APIs con Spring Boot, priorizando el rendimiento, la experiencia de usuario y la calidad del código.',
  },
  {
    position: 'Full Stack Developer — Semisenior',
    company: 'Zabud Technologies',
    period: 'Dic 2019 — Oct 2024',
    description:
      'Participé en el desarrollo y mantenimiento de aplicaciones empresariales con Angular y Spring Boot, implementando nuevas funcionalidades, resolviendo incidencias y contribuyendo a la creación de soluciones escalables dentro de equipos ágiles.',
  },
  {
    position: 'Frontend Developer — Junior',
    company: 'Zabud Technologies (Cliente: Mutual SER)',
    period: 'Feb 2020 — Dic 2022',
    description:
      'Desarrollé interfaces web responsivas con Vue y JavaScript, creando componentes reutilizables y colaborando estrechamente con los equipos de diseño y backend para ofrecer una experiencia de usuario intuitiva y eficiente.',
  },
]
---

<section
  id={id}
  class="relative scroll-mt-16 overflow-x-hidden bg-background text-accent"
>
  <div class="max-w-6xl mx-auto px-4 lg:px-6 py-24">
    <!-- Encabezado -->
    <header class="mb-12">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none">
        Experiencia
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#6B665F]">
        Mi trayectoria como desarrollador profesional.
      </p>
    </header>

    <!-- Tarjetas -->
    <ol class="flex flex-col gap-6">
      {
        experiences.map((exp) => (
          <li>
            <article class="bg-background-hero border border-accent/10 rounded-3xl p-6 sm:p-8">
              <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-xl sm:text-2xl font-bold leading-tight">{exp.company}</h3>
                  {exp.current && (
                    <span class="rounded-full bg-secondary text-[#12161C] text-xs font-bold uppercase tracking-wide px-3 py-1">
                      Actual
                    </span>
                  )}
                </div>
                <p class="w-fit shrink-0 rounded-lg bg-accent/[0.07] text-[#6B665F] text-sm font-medium px-3 py-1.5">
                  {exp.period}
                </p>
              </div>

              <p class="mt-3 text-lg font-semibold text-[#0E7A65]">{exp.position}</p>

              <p class="mt-4 max-w-3xl leading-relaxed text-accent/90">{exp.description}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>