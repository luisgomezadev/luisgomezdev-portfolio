---
const links = [
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#habilidades', label: 'Habilidades' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
]
---

<header
  class="site-nav fixed top-0 left-0 w-full z-30 h-16 bg-[#F6EFE4]/80 backdrop-blur-md text-[#2B2A28]"
>
  <nav
    class="max-w-6xl mx-auto h-full px-4 lg:px-6 flex items-center justify-center lg:justify-between"
  >
    <a
      href="#inicio"
      class="flex items-center gap-3 rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <span class="flex items-center justify-center w-10 h-10 bg-[#12161C] rounded-xl">
        <img src="/logo_personal_blanco.webp" alt="Logo Luis Gomez Dev" class="w-6" />
      </span>
      <span class="text-xl font-bold tracking-tight">LuisGomezDev</span>
    </a>

    <ul class="hidden lg:flex items-center gap-1 bg-[#2B2A28]/[0.06] rounded-full p-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-full px-4 py-2 text-sm font-semibold uppercase tracking-wide text-[#2B2A28]/80 hover:bg-white hover:text-[#2B2A28] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/files/CV_Luis_Gomez_2026.pdf"
      class="hidden lg:inline-block rounded-full bg-primary text-[#12161C] px-6 py-2.5 text-sm font-semibold uppercase tracking-wide hover:bg-primary/90 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#12161C]"
    >
      Descargar CV
    </a>
  </nav>
</header>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

  .site-nav {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
  }
</style>