---
import GitHub from '../assets/icons/GitHub.astro'
import LinkedIn from '../assets/icons/LinkedIn.astro'
import EmailIcon from '../assets/icons/EmailIcon.astro'

const { id } = Astro.props

const contacts = [
  {
    title: 'GitHub',
    href: 'https://github.com/luisgomezadev',
    icon: GitHub,
    description: 'Visita mi perfil de GitHub para ver mis proyectos y contribuciones.',
  },
  {
    title: 'LinkedIn',
    href: 'https://www.linkedin.com/in/luisgomezdev/',
    icon: LinkedIn,
    description: 'Conéctate conmigo en LinkedIn para oportunidades profesionales.',
  },
  {
    title: 'Enviar correo',
    href: 'mailto:luisgomez24g@gmail.com',
    icon: EmailIcon,
    description: 'Envíame un correo electrónico para consultas o colaboraciones.',
  },
]
---

<section
  id={id}
  class="relative scroll-mt-16 overflow-x-hidden bg-[#F5EFE6] text-[#2B2A28]"
>
  <div class="max-w-6xl mx-auto px-4 lg:px-6 py-24">
    <!-- Encabezado -->
    <header class="mb-12">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none">
        Contacto
      </h2>
      <p class="mt-3 text-base sm:text-lg text-[#6B665F] max-w-xl leading-relaxed">
        ¡Hablemos! Estoy abierto a nuevas oportunidades y colaboraciones.
      </p>
    </header>

    <!-- Tarjetas -->
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        contacts.map((contact) => {
          const Icon = contact.icon
          return (
            <li>
              <a
                href={contact.href}
                title={contact.title}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-full flex-col gap-4 bg-[#F1E5D5]/60 border border-[#2B2A28]/10 rounded-3xl p-6 sm:p-8 hover:bg-white hover:border-primary hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >
                <span
                  class="flex w-12 h-12 items-center justify-center rounded-xl bg-[#12161C] text-[#F6EFE4]"
                >
                  <Icon size={24} />
                </span>
                <span class="text-xl font-bold leading-tight text-[#0E7A65]">{contact.title}</span>
                <span class="leading-relaxed text-[#2B2A28]/90">{contact.description}</span>
              </a>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>