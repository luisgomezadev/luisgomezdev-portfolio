---
import CvIcon from '../assets/icons/CvIcon.astro'
import EmailIcon from '../assets/icons/EmailIcon.astro'

import ButtonLink from './shared/ButtonLink.astro'

const { id } = Astro.props

const highlights = ['Java', 'Spring Boot', 'Angular']
---

<section
  id={id}
  class="relative min-h-screen scroll-mt-16 overflow-x-hidden bg-background-hero text-accent flex items-center"
>
  <div
    class="max-w-6xl mx-auto w-full px-4 lg:px-6 pt-28 pb-24 grid gap-14 md:grid-cols-12 items-center"
  >
    <!-- Texto -->
    <div class="md:col-span-7 text-center md:text-left">
      <span class="motion-safe:animate-fade-up text-sm font-medium text-[#6B665F] mb-4 block">
       Ingeniero de Software · Desarrollador Full Stack
      </span>

      <h1
        class="motion-safe:animate-fade-up [animation-delay:100ms] text-[clamp(3.25rem,10vw,6rem)] font-extrabold leading-[0.95] tracking-tight"
      >
        Luis Gómez<br />Arteaga
      </h1>

      <span
        class="motion-safe:animate-fade-up [animation-delay:250ms] inline-block mt-5 -rotate-2 bg-[#12161C] text-background-hero text-lg sm:text-xl font-extrabold uppercase tracking-wide px-5 py-2 rounded-sm"
      >
        Ingeniero de Software
      </span>

      <p
        class="motion-safe:animate-fade-up [animation-delay:400ms] mt-8 text-lg leading-relaxed text-[#6B665F] max-w-md mx-auto md:mx-0"
      >
        Construyo aplicaciones web escalables con Java, Spring Boot y Angular, cuidando tanto el
        rendimiento del backend como la experiencia de quien usa la interfaz.
      </p>

      <ul
        class="motion-safe:animate-fade-up [animation-delay:500ms] mt-6 flex flex-wrap gap-x-6 gap-y-2 justify-center md:justify-start text-sm font-medium"
        aria-label="Tecnologías principales"
      >
        {
          highlights.map((item) => (
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-secondary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <footer
        class="motion-safe:animate-fade-up [animation-delay:600ms] flex flex-wrap gap-3 mt-10 justify-center md:justify-start"
      >
        <ButtonLink
          title="Descargar CV de Luis Gomez"
          class="rounded-full bg-primary text-[#12161C] font-semibold uppercase tracking-wide hover:bg-primary/90"
          href="/files/CV_Luis_Gomez_2026.pdf"
        >
          <CvIcon size={20} />
          Descargar mi CV
        </ButtonLink>
        <ButtonLink
          href="mailto:luisgomez24g@gmail.com"
          title="Enviar correo a Luis Gomez"
          class="rounded-full border border-accent/20 bg-transparent text-accent font-semibold uppercase tracking-wide hover:border-primary hover:text-[#12161C] hover:bg-white/60"
        >
          <EmailIcon size={20} />
          Contactar
        </ButtonLink>
      </footer>
    </div>

    <!-- Foto -->
    <div
      class="motion-safe:animate-fade-in-right [animation-delay:200ms] md:col-span-5 relative w-fit mx-auto md:mx-0 md:justify-self-end"
    >
      <span
        class="absolute inset-0 translate-x-4 translate-y-4 rounded-4xl bg-secondary/30"
        aria-hidden="true"></span>
      <img
        src="/images/perfil_linkedin.webp"
        alt="Luis Alberto Gómez Perfil"
        class="relative block w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 object-cover rounded-4xl shadow-xl shadow-accent/15"
      />
      <p
        class="motion-safe:animate-fade-up [animation-delay:800ms] absolute -bottom-4 -left-4 flex items-center gap-2 bg-white rounded-full px-4 py-2 text-sm font-semibold shadow-lg shadow-accent/10"
      >
        <span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
        +5 años de experiencia
      </p>
    </div>
  </div>
</section>